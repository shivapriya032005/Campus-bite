# MySQL (used when running via Docker Compose)
MYSQL_DATABASE=campusbite
MYSQL_USER=campusbite_user
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Local development database (when running outside Docker)
DATABASE_URL_OVERRIDE=sqlite:///./campusbite.db

# FastAPI
APP_NAME=CampusBite API
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET_KEY=replace_with_a_long_random_secret_before_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (optional, server-side AI integration)
OPENAI_API_KEY=
