# MySQL (used when running via Docker Compose)
MYSQL_DATABASE=campusbite
MYSQL_USER=campusbite_user
MYSQL_PASSWORD=change_this_local_password
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Local development database (when running outside Docker)
DATABASE_URL_OVERRIDE=sqlite:///./campusbite.db

# FastAPI
APP_NAME=CampusBite API
APP_ENV=development
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET_KEY=replace_with_a_long_random_secret_before_use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (optional, server-side AI integration)
OPENAI_API_KEY=

# CORS: comma-separated list of allowed frontend origins (no wildcard; credentials are allowed).
# In development http://localhost:5173 and http://127.0.0.1:5173 are added automatically.
# In production list your real origin(s), e.g. https://campusbite.example.com
CORS_ORIGINS=

# Account approval: owners and delivery partners register unapproved. Approve them with
#   POST /api/v1/admin/users/{id}/approve   and header   X-Admin-Key: <ADMIN_API_KEY>
# Leave empty to disable the admin API. Must be at least 32 random characters in production.
ADMIN_API_KEY=

# Rate limits (max requests per window), shared across all workers through the database.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_SECONDS=3600
# Honour X-Forwarded-For for the client IP. Enable ONLY behind a trusted reverse proxy.
TRUST_PROXY_HEADERS=false

# Background scheduler (stale-order reminders). true = run inside the API process (development).
# Production: false for the API, with exactly one dedicated "python -m app.scheduler" process.
SCHEDULER_ENABLED=true
REMINDER_THRESHOLD_MINUTES=15
REMINDER_CHECK_INTERVAL_MINUTES=5

# --- Production (docker-compose.prod.yml with a separate .env.prod) --------------------------
# APP_ENV=production makes the app refuse to start with a weak or default JWT_SECRET_KEY
# (shorter than 32 chars or a placeholder), a default MYSQL_PASSWORD, or no CORS_ORIGINS.
# Generate secrets with:  openssl rand -hex 32
